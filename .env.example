# Conexión a JAREMAR (SQL Server) para el discovery de Fase 0
# Copia este archivo como .env y completa los valores reales. .env nunca se sube a git.

JAREMAR_SERVER=localhost
JAREMAR_PORT=1433
JAREMAR_DATABASE=JAREMAR

# AUTH_MODE=sql  -> usa JAREMAR_USER / JAREMAR_PASSWORD
# AUTH_MODE=windows -> usa autenticación integrada (Trusted_Connection), ignora user/password
JAREMAR_AUTH_MODE=sql
JAREMAR_USER=
JAREMAR_PASSWORD=

# Driver ODBC instalado en la máquina (ej: "ODBC Driver 17 for SQL Server")
JAREMAR_ODBC_DRIVER=ODBC Driver 17 for SQL Server
